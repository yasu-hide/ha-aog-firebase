# コピーして functions/.env.<projectId> を作成し、値を設定する
# OAUTH_CLIENT_SECRET はシークレット: firebase functions:secrets:set OAUTH_CLIENT_SECRET
OAUTH_CLIENT_ID=
# HOMEGRAPH_API_KEY: プロジェクトのWeb APIキー (またはHomeGraph APIを有効にしたキー)。
# 旧 functions.config().firebase.apiKey の値。functions:config:export では引き継がれない
HOMEGRAPH_API_KEY=
